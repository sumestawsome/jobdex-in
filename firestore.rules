rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserRole() {
      return isSignedIn()
        ? (
            "role" in request.auth.token && request.auth.token.role != null
              ? request.auth.token.role
              : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active == true
                   ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                   : null)
          )
        : null;
    }

    function isSuperAdmin() {
      let role = currentUserRole();
      return role == "super_admin";
    }

    function isKoordinatorDivisi() {
      let role = currentUserRole();
      return role == "koordinator_divisi";
    }

    function isKoordinatorAcara() {
      let role = currentUserRole();
      return role == "koordinator_acara";
    }

    function isKoordinator() {
      let role = currentUserRole();
      return role == "super_admin" ||
        role == "koordinator_divisi" ||
        role == "koordinator_acara";
    }

    function currentUserOrgId() {
      return request.auth.token != null && "org_id" in request.auth.token
        ? request.auth.token.org_id
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? (
              "org_id" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.org_id
                : ("orgId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                  ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
                  : ("organization_id" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                    ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id
                    : "main_org"))
            )
          : "main_org");
    }

    function currentUserCampusId() {
      return request.auth.token != null && "univ_id" in request.auth.token
        ? request.auth.token.univ_id
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? (
              "campus_id" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.campus_id
                : ("campusId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                  ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.campusId
                  : ("univ_id" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                    ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.univ_id
                    : ("univId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                      ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.univId
                      : "univ-undiksha")))
            )
          : "univ-undiksha");
    }

    function isSameOrg(docOrg, userOrg) {
      return docOrg == userOrg ||
        docOrg == "main_org" ||
        docOrg == "org-undiksha-forkom-kip" ||
        docOrg == "org-undiksha-bem" ||
        docOrg == "org-ui-bem" ||
        userOrg == "main_org" ||
        userOrg == "org-undiksha-forkom-kip" ||
        userOrg == "org-undiksha-bem" ||
        userOrg == "org-ui-bem";
    }

    function isSameCampus(docCampus, userCampus) {
      return docCampus == userCampus ||
        docCampus == "" ||
        docCampus == "univ-undiksha" ||
        docCampus == "ui" ||
        userCampus == "" ||
        userCampus == "univ-undiksha" ||
        userCampus == "ui";
    }

    function matchesTenant(data) {
      let userOrg = currentUserOrgId();
      let userCampus = currentUserCampusId();
      let docOrg = "organization_id" in data
        ? data.organization_id
        : ("org_id" in data
          ? data.org_id
          : ("orgId" in data ? data.orgId : "main_org"));
      let docCampus = "campus_id" in data
        ? data.campus_id
        : ("campusId" in data
          ? data.campusId
          : ("univ_id" in data ? data.univ_id : ("univId" in data ? data.univId : "univ-undiksha")));

      return isSuperAdmin() || (isSameOrg(docOrg, userOrg) && isSameCampus(docCampus, userCampus));
    }

    function canManageEvent(eventId) {
      return isSuperAdmin() ||
        isEventCoordinator(eventId) ||
        isEventSecretary(eventId) ||
        (
          isKoordinatorDivisi() &&
          getEventMemberRole(eventId) != "anggota_acara" &&
          getEventMemberRole(eventId) != "sekretaris_acara"
        );
    }

    function isEventMember(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/event_members/$(request.auth.uid));
    }

    function getEventMemberRole(eventId) {
      return isEventMember(eventId)
        ? get(/databases/$(database)/documents/events/$(eventId)/event_members/$(request.auth.uid)).data.role_in_event
        : null;
    }

    function isEventSecretary(eventId) {
      let role = getEventMemberRole(eventId);
      return role == "sekretaris_acara" || 
        role == "Sekretaris Acara" || 
        role == "sekretaris" || 
        role == "Sekretaris";
    }

    function isEventCoordinator(eventId) {
      let role = getEventMemberRole(eventId);
      return role == "koordinator_acara" ||
        role == "Koordinator Acara" ||
        role == "koordinator" ||
        role == "Koordinator" ||
        (
          exists(/databases/$(database)/documents/events/$(eventId)) &&
          get(/databases/$(database)/documents/events/$(eventId)).data.coordinator_id == request.auth.uid
        );
    }

    function canReadTaskData(data) {
      return isSuperAdmin() ||
        (
          isKoordinatorDivisi() &&
          (
            !("division_id" in data) ||
            data.division_id == "" ||
            data.division_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.division_id
          )
        ) ||
        (
          data.type == "acara" &&
          data.event_id != null &&
          data.event_id != "" &&
          (
            isEventCoordinator(data.event_id) ||
            isEventSecretary(data.event_id) ||
            isEventMember(data.event_id)
          )
        ) ||
        data.pic_id == request.auth.uid;
    }

    function canCreateTaskData(data) {
      return isSuperAdmin() ||
        (
          isKoordinatorDivisi() &&
          (data.type != "acara" || getEventMemberRole(data.event_id) != "anggota_acara") &&
          (data.type != "divisi" || data.division_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.division_id)
        ) ||
        (
          data.type == "acara" &&
          data.event_id != null &&
          data.event_id != "" &&
          (
            isEventCoordinator(data.event_id) ||
            isEventSecretary(data.event_id)
          ) &&
          data.created_by == request.auth.uid
        );
    }

    function canUpdateTaskData() {
      return isSuperAdmin() ||
        (
          isKoordinatorDivisi() &&
          (resource.data.type != "acara" || getEventMemberRole(resource.data.event_id) != "anggota_acara") &&
          (resource.data.type != "divisi" || resource.data.division_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.division_id)
        ) ||
        (
          resource.data.type == "acara" &&
          resource.data.event_id != null &&
          resource.data.event_id != "" &&
          (
            isEventCoordinator(resource.data.event_id) ||
            isEventSecretary(resource.data.event_id)
          ) &&
          request.resource.data.event_id == resource.data.event_id
        );
    }

    function canPicUpdateTaskWorkflow() {
      return resource.data.pic_id == request.auth.uid &&
        request.resource.data.pic_id == resource.data.pic_id &&
        request.resource.data.coordinator_id == resource.data.coordinator_id &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.organization_id == resource.data.organization_id &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.event_id == resource.data.event_id &&
        request.resource.data.division_id == resource.data.division_id &&
        request.resource.data.status != "approved" &&
        (
          changedOnly(["status", "stuck_notes", "updated_at"]) ||
          changedOnly(["checklist_items", "updated_at"])
        );
    }

    function canCreateStatusLog(taskId) {
      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return canReadTaskData(task) &&
        (
          isSuperAdmin() ||
          isKoordinatorDivisi() ||
          (
            isKoordinatorAcara() &&
            task.type == "acara" &&
            task.coordinator_id == request.auth.uid
          ) ||
          (
            task.type == "acara" &&
            task.event_id != null &&
            task.event_id != "" &&
            isEventSecretary(task.event_id)
          ) ||
          (task.pic_id == request.auth.uid && request.resource.data.to_status != "approved")
        ) &&
        request.resource.data.task_id == taskId &&
        request.resource.data.changed_by == request.auth.uid;
    }

    function canCreateDesignReferenceData(data) {
      let role = currentUserRole();
      return (
        role == "super_admin" ||
        role == "koordinator_divisi" ||
        role == "koordinator_acara"
      ) &&
        matchesTenant(data) &&
        data.created_by == request.auth.uid &&
        data.is_archived == false;
    }

    function canUpdateDesignReference() {
      let role = currentUserRole();
      return role == "super_admin" ||
        role == "koordinator_divisi" ||
        (
          role == "koordinator_acara" &&
          resource.data.created_by == request.auth.uid &&
          request.resource.data.created_by == resource.data.created_by
        );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function changedOnly(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedFields);
    }

    function immutableUserIdentity() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.organization_id == resource.data.organization_id &&
        (!("org_id" in resource.data) || !("org_id" in request.resource.data) || request.resource.data.org_id == resource.data.org_id) &&
        (!("orgId" in resource.data) || !("orgId" in request.resource.data) || request.resource.data.orgId == resource.data.orgId) &&
        (!("campus_id" in resource.data) || !("campus_id" in request.resource.data) || request.resource.data.campus_id == resource.data.campus_id) &&
        (!("campusId" in resource.data) || !("campusId" in request.resource.data) || request.resource.data.campusId == resource.data.campusId) &&
        (!("univ_id" in resource.data) || !("univ_id" in request.resource.data) || request.resource.data.univ_id == resource.data.univ_id) &&
        (!("univId" in resource.data) || !("univId" in request.resource.data) || request.resource.data.univId == resource.data.univId) &&
        request.resource.data.created_at == resource.data.created_at;
    }

    function immutableOwnership() {
      return (
        (!("organization_id" in resource.data) || !("organization_id" in request.resource.data) || request.resource.data.organization_id == resource.data.organization_id) &&
        (!("org_id" in resource.data) || !("org_id" in request.resource.data) || request.resource.data.org_id == resource.data.org_id) &&
        (!("orgId" in resource.data) || !("orgId" in request.resource.data) || request.resource.data.orgId == resource.data.orgId) &&
        (!("campus_id" in resource.data) || !("campus_id" in request.resource.data) || request.resource.data.campus_id == resource.data.campus_id) &&
        (!("campusId" in resource.data) || !("campusId" in request.resource.data) || request.resource.data.campusId == resource.data.campusId) &&
        (!("univ_id" in resource.data) || !("univ_id" in request.resource.data) || request.resource.data.univ_id == resource.data.univ_id) &&
        (!("univId" in resource.data) || !("univId" in request.resource.data) || request.resource.data.univId == resource.data.univId)
      );
    }

    function selfProfileUpdateIsSafe() {
      return immutableUserIdentity() &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.is_active == resource.data.is_active &&
        request.resource.data.division_id == resource.data.division_id &&
        changedOnly(["name", "whatsapp_number", "avatar_url", "updated_at"]);
    }

    function coordinatorMemberUpdateIsSafe() {
      return immutableUserIdentity() &&
        resource.data.role != "super_admin" &&
        request.resource.data.role == resource.data.role &&
        changedOnly([
          "name",
          "whatsapp_number",
          "division_id",
          "is_active",
          "updated_at"
        ]);
    }

    function isReferenceEligible(data) {
      return (
        ("reference_candidate_enabled" in data && data.reference_candidate_enabled == true) ||
        (
          !("reference_candidate_enabled" in data) &&
          data.status == "approved" &&
          (
            data.category_key == "desain_publikasi" ||
            data.category_key == "identitas_acara_dan_panitia" ||
            data.category_key == "aset_desain" ||
            data.subcategory_key == "poster" ||
            data.subcategory_key == "name_tag" ||
            data.subcategory_key == "twibbon" ||
            data.subcategory_key == "feed_ig" ||
            data.subcategory_key == "story_ig" ||
            data.subcategory_key == "banner" ||
            data.subcategory_key == "sertifikat" ||
            data.subcategory_key == "dokumentasi" ||
            data.subcategory_key == "animasi" ||
            data.subcategory_key == "merchandise" ||
            data.name.matches("(?i).*(poster|spanduk|banner|nametag|piagam|feed|story|desain).*")
          )
        )
      );
    }

    match /users/{userId} {
      allow create: if isSelf(userId) &&
        request.resource.data.role == "anggota" &&
        request.resource.data.id == request.auth.uid;

      allow read: if isSignedIn() && (
        isSelf(userId) ||
        isSuperAdmin() ||
        matchesTenant(resource.data)
      );

      allow update: if isSelf(userId) && selfProfileUpdateIsSafe();

      allow update: if isKoordinatorDivisi() &&
        matchesTenant(resource.data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.division_id == resource.data.division_id &&
        coordinatorMemberUpdateIsSafe();

      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    match /campuses/{campusId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /ormawas/{ormawaId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.campus_id != "");
      allow update: if isSuperAdmin() || (isKoordinator() && ormawaId == currentUserOrgId());
      allow delete: if false;
    }

    match /ormawa_members/{memberId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.user_id == request.auth.uid ||
        resource.data.ormawa_id == currentUserOrgId()
      );
      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        isKoordinator() ||
        request.resource.data.user_id == request.auth.uid
      );
      allow delete: if isSuperAdmin() || (isKoordinator() && resource.data.ormawa_id == currentUserOrgId());
    }

    match /organizations/{organizationId} {
      allow read: if isSignedIn();

      allow create, update: if isSuperAdmin() || (isKoordinator() && organizationId == currentUserOrgId());

      allow delete: if false;
    }

    match /divisions/{divisionId} {
      allow read: if isSignedIn() && matchesTenant(resource.data);

      allow create: if isSignedIn() &&
        (isSuperAdmin() || isKoordinatorDivisi()) &&
        matchesTenant(request.resource.data);

      // super_admin bisa update semua divisi
      // koordinator_divisi hanya bisa update design_kit fields divisinya sendiri
      allow update: if isSuperAdmin() ||
        (
          isKoordinatorDivisi() &&
          matchesTenant(resource.data) &&
          immutableOwnership() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.division_id == divisionId &&
          changedOnly([
            "design_kit_color_palette",
            "design_kit_visual_direction",
            "design_kit_supergraphic_notes",
            "design_kit_design_reference_links",
            "design_kit_drive_reference_links",
            "design_kit_archive_drive_links",
            "design_kit_notes_for_members",
            "updated_at"
          ])
        );

      allow delete: if false;
    }

    match /events/{eventId} {
      allow get: if isSignedIn() && matchesTenant(resource.data) && (
        isSuperAdmin() ||
        isKoordinatorDivisi() ||
        isEventMember(eventId) ||
        resource.data.coordinator_id == request.auth.uid
      );

      allow list: if isSignedIn() && matchesTenant(resource.data) && (
        isSuperAdmin() ||
        isKoordinatorDivisi() ||
        resource.data.coordinator_id == request.auth.uid ||
        isEventMember(eventId)
      );

      allow create: if isSignedIn() &&
        matchesTenant(request.resource.data) &&
        (
          isSuperAdmin() ||
          isKoordinatorDivisi() ||
          (
            isKoordinatorAcara() &&
            request.resource.data.created_by == request.auth.uid &&
            request.resource.data.coordinator_id == request.auth.uid
          )
        );

      allow update: if canManageEvent(eventId) && matchesTenant(resource.data) && immutableOwnership();

      allow delete: if false; // TODO: evaluasi delete acara setelah workflow task tersedia.

      match /event_members/{memberId} {
        allow read: if isSignedIn() &&
          matchesTenant(get(/databases/$(database)/documents/events/$(eventId)).data) &&
          (isSuperAdmin() || isKoordinatorDivisi() || isEventMember(eventId));

        allow create, update: if isSignedIn() &&
          canManageEvent(eventId) &&
          matchesTenant(get(/databases/$(database)/documents/events/$(eventId)).data) &&
          request.resource.data.event_id == eventId &&
          request.resource.data.user_id == memberId;

        allow delete: if isSignedIn() &&
          canManageEvent(eventId) &&
          matchesTenant(get(/databases/$(database)/documents/events/$(eventId)).data);
      }
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && matchesTenant(resource.data) && (
        canReadTaskData(resource.data) ||
        (
          isReferenceEligible(resource.data) &&
          (
            !("data_sensitivity" in resource.data) ||
            resource.data.data_sensitivity != "sensitive"
          )
        )
      );

      allow list: if isSignedIn() && matchesTenant(resource.data) && (
        resource.data.pic_id == request.auth.uid ||
        isSuperAdmin() ||
        (
          isKoordinatorDivisi() &&
          (
            !("division_id" in resource.data) ||
            resource.data.division_id == "" ||
            resource.data.division_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.division_id
          )
        ) ||
        (
          resource.data.event_id != null &&
          resource.data.event_id != "" &&
          (
            isEventCoordinator(resource.data.event_id) ||
            isEventSecretary(resource.data.event_id) ||
            isEventMember(resource.data.event_id)
          )
        ) ||
        (
          isReferenceEligible(resource.data)
        )
      );

      allow create: if isSignedIn() &&
        canCreateTaskData(request.resource.data) &&
        matchesTenant(request.resource.data) &&
        request.resource.data.is_archived == false;

      allow update: if isSignedIn() &&
        matchesTenant(resource.data) &&
        immutableOwnership() &&
        (canUpdateTaskData() || canPicUpdateTaskWorkflow());

      allow delete: if false;

      match /status_logs/{logId} {
        allow read: if isSignedIn() &&
          matchesTenant(get(/databases/$(database)/documents/tasks/$(taskId)).data) &&
          canReadTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data);
        allow create: if isSignedIn() &&
          matchesTenant(get(/databases/$(database)/documents/tasks/$(taskId)).data) &&
          canCreateStatusLog(taskId);
        allow update, delete: if false;
      }

      match /uploads/{uploadId} {
        allow read: if isSignedIn() &&
          matchesTenant(get(/databases/$(database)/documents/tasks/$(taskId)).data) && (
          canReadTaskData(get(/databases/$(database)/documents/tasks/$(taskId)).data) ||
          (
            isReferenceEligible(get(/databases/$(database)/documents/tasks/$(taskId)).data) &&
            (
              !("data_sensitivity" in get(/databases/$(database)/documents/tasks/$(taskId)).data) ||
              get(/databases/$(database)/documents/tasks/$(taskId)).data.data_sensitivity != "sensitive"
            )
          )
        );
        allow create, update, delete: if false; // Metadata upload ditulis server API via Admin SDK.
      }
    }

    match /design_references/{referenceId} {
      allow read: if isSignedIn() &&
        matchesTenant(resource.data) &&
        (resource.data.is_archived == false || isKoordinator());

      allow create: if isSignedIn() &&
        matchesTenant(request.resource.data) &&
        canCreateDesignReferenceData(request.resource.data) &&
        request.resource.data.id == referenceId;

      allow update: if isSignedIn() &&
        matchesTenant(resource.data) &&
        immutableOwnership() &&
        canUpdateDesignReference() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.organization_id == resource.data.organization_id &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.created_at == resource.data.created_at;

      allow delete: if false;
    }

    match /whatsapp_logs/{logId} {
      allow read: if isKoordinator() && matchesTenant(resource.data);
      allow write: if false; // Log WhatsApp ditulis server API via Admin SDK.
    }

    match /ai_logs/{logId} {
      allow read: if isKoordinator() && matchesTenant(resource.data);
      allow write: if false; // Log AI ditulis server API via Admin SDK.
    }

    match /whatsapp_task_candidates/{candidateId} {
      allow read, write: if false;
    }

    match /whatsapp_task_edit_previews/{previewId} {
      allow read, write: if false;
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isKoordinatorDivisi();
    }

    match /{path=**}/event_members/{memberId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isKoordinatorDivisi() ||
        request.auth.uid == resource.data.user_id
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
